#[models]
#[ollama]
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_DS=deepseek-r1:7b
OLLAMA_MODEL_QWEN=qwen3:8b

#[deepseek]
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=

#[qwen]
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL_NAME=

#[mimo]
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL_NAME=mimo-v2.5-pro

#[observability]
# 可选：不设置则完全关闭遥测；仅支持 logfire 或 langfuse。
# OBS_BACKEND=logfire
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

#[mcps]
#[test]
MCP_SERVER_URL=
# 可选：未设置时分别使用 $AZ_HOME/mcp.json 和 $AZ_HOME/skills
# MCP_CONFIG_PATH=
# SKILLS_DIR=

#[context compaction]
# Estimated-token budget for each model request. Older history is compacted above it.
CONTEXT_TARGET_TOKENS=48000
CONTEXT_KEEP_MESSAGES=20
CONTEXT_KEEP_TOOL_PAIRS=4
CONTEXT_MAX_PART_TOKENS=30000

#[plan mode]
USE_PLANNING_MODE=true
PLANNING_CACHE_TTL=5m

#[mysql mcp]
MYSQL_MCP_COMMAND=mcp-server-mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_DB=
# MYSQL_CONNECTION_STRING=

ALLOW_INSERT_OPERATION=false
ALLOW_UPDATE_OPERATION=false
ALLOW_DELETE_OPERATION=false
